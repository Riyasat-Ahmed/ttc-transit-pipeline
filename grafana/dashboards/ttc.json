            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Network avg delay (last hour)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ttc-timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ttc-timescaledb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT avg(delay_s) / 60.0 AS \"avg delay\" FROM stop_delays\n        WHERE scheduled_at BETWEEN now() - interval '1 hour' AND now()"
        }
      ],
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "10 latest-running routes (last hour, avg delay)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ttc-timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ttc-timescaledb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(r.route_short_name || ' ' || r.route_long_name, d.route_id) AS route,\n               avg(d.delay_s) / 60.0 AS avg_delay_min\n        FROM stop_delays d LEFT JOIN routes r USING (route_id)\n        WHERE d.scheduled_at BETWEEN now() - interval '1 hour' AND now()\n        GROUP BY 1 HAVING count(*) >= 20\n        ORDER BY 2 DESC LIMIT 10"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [],
          "values": true,
          "fields": "/^avg_delay_min$/"
        }
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Routes",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "table",
      "title": "Worst routes (last hour): average and p90 delay",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ttc-timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ttc-timescaledb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(r.route_short_name || ' ' || r.route_long_name, d.route_id) AS \"Route\",\n               round(avg(d.delay_s) / 60.0, 1) AS \"Avg (min)\",\n               round((percentile_cont(0.9) WITHIN GROUP (ORDER BY d.delay_s) / 60.0)::numeric, 1)\n                   AS \"p90 (min)\",\n               count(*) AS \"Stop arrivals\"\n        FROM stop_delays d LEFT JOIN routes r USING (route_id)\n        WHERE d.scheduled_at BETWEEN now() - interval '1 hour' AND now()\n        GROUP BY 1 HAVING count(*) >= 20\n        ORDER BY 2 DESC LIMIT 25"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 10,
        "h": 11
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Avg.*|p90.*"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 2
                    },
                    {
                      "color": "orange",
                      "value": 5
                    },
                    {
                      "color": "red",
                      "value": 10
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Delay by hour of day: $route (past 7 days, Toronto time)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ttc-timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ttc-timescaledb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT lpad(extract(hour FROM bucket AT TIME ZONE 'America/Toronto')::text, 2, '0')\n                   || ':00' AS hour,\n               sum(avg_delay_s * n) / sum(n) / 60.0 AS \"avg delay\",\n               avg(p90_delay_s) / 60.0 AS \"p90 delay (mean of hourly p90s)\"\n        FROM route_delay_1h\n        WHERE route_id = '$route' AND bucket > now() - interval '7 days'\n        GROUP BY 1 ORDER BY 1"
        }
      ],
      "gridPos": {
        "x": 10,
        "y": 18,
        "w": 14,
        "h": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "xField": "hour",
        "orientation": "vertical",
        "showValue": "never",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Average delay over time: $route vs network (15 min buckets)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ttc-timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ttc-timescaledb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT bucket AS time, sum(avg_delay_s * n) / sum(n) / 60.0 AS network\n        FROM route_delay_15m WHERE $__timeFilter(bucket)\n        GROUP BY 1 ORDER BY 1"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ttc-timescaledb"
          },
          "refId": "B",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT bucket AS time, avg_delay_s / 60.0 AS \"$route\"\n        FROM route_delay_15m WHERE route_id = '$route' AND $__timeFilter(bucket)\n        ORDER BY 1"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "On-time performance (daily job: −1 to +5 min)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ttc-timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ttc-timescaledb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT o.service_date AS \"Service day\", coalesce(r.route_short_name || ' ' || r.route_long_name, o.route_id)\n                   AS \"Route\",\n               round(o.otp_pct::numeric, 1) AS \"On time %\", o.early AS \"Early\", o.on_time AS \"On time\",\n               o.late AS \"Late\", round((o.avg_delay_s / 60.0)::numeric, 1) AS \"Avg delay (min)\"\n        FROM route_otp_daily o LEFT JOIN routes r USING (route_id)\n        WHERE o.service_date = (SELECT max(service_date) FROM route_otp_daily) AND o.n >= 100\n        ORDER BY o.otp_pct ASC"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 8
      }
    },
    {
      "id": 11,
      "type": "row",
