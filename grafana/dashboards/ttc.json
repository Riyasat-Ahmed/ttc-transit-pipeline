{
  "uid": "ttc-transit",
  "title": "TTC Real-Time Transit",
  "description": "Contains information licensed under the Open Government Licence – Toronto.",
  "tags": [
    "ttc",
    "gtfs"
  ],
  "timezone": "America/Toronto",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "ttc-timescaledb"
        },
        "query": "SELECT route_short_name || ' ' || route_long_name AS __text, route_id AS __value FROM routes WHERE route_type <> 1 ORDER BY route_short_name::int NULLS LAST",
        "definition": "routes",
        "refresh": 1,
        "sort": 0,
        "current": {
          "text": "504 King",
          "value": "504"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Live",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "geomap",
      "title": "Vehicles now (colour = current delay, min)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ttc-timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ttc-timescaledb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT v.lat, v.lon, v.vehicle_id, v.route_id,\n               coalesce(r.route_short_name || ' ' || r.route_long_name, v.route_id) AS route,\n               round(d.delay_s / 60.0, 1) AS delay_min,\n               v.ts AS reported_at\n        FROM (\n            SELECT DISTINCT ON (vehicle_id) *\n            FROM vehicle_positions\n            WHERE ts > now() - interval '3 minutes'\n            ORDER BY vehicle_id, ts DESC\n        ) v\n        LEFT JOIN routes r ON r.route_id = v.route_id\n        LEFT JOIN LATERAL (\n            SELECT delay_s FROM stop_delays sd\n            WHERE sd.trip_id = v.trip_id AND sd.scheduled_at > now() - interval '4 hours'\n            ORDER BY sd.feed_ts DESC, sd.stop_sequence DESC LIMIT 1\n        ) d ON true"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 16,
        "h": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "coords",
          "lat": 43.7,
          "lon": -79.4,
          "zoom": 10.5
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true
        },
        "basemap": {
          "type": "default",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Vehicles",
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "config": {
              "showLegend": true,
              "style": {
                "size": {
                  "fixed": 4
                },
                "opacity": 0.8,
                "color": {
                  "field": "delay_min",
                  "fixed": "dark-green"
                },
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                }
              }
            },
            "tooltip": true
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Vehicles reporting",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ttc-timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ttc-timescaledb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(DISTINCT vehicle_id) AS vehicles FROM vehicle_positions\n        WHERE ts > now() - interval '3 minutes'"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
