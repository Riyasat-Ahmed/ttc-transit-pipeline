    {
      "id": 12,
      "type": "stat",
      "title": "Feed staleness (s since last new snapshot)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ttc-timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ttc-timescaledb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT feed, extract(epoch FROM now() - max(feed_ts))::int AS staleness_s\n        FROM feed_health WHERE ts > now() - interval '1 day' AND ok GROUP BY feed"
        }
      ],
      "gridPos": {
