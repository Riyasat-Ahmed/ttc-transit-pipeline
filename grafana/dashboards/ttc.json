    {
      "id": 17,
      "type": "timeseries",
      "title": "Messages per minute: received / malformed / duplicates dropped",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ttc-timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ttc-timescaledb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('1 minute', ts) AS time,\n               sum(received) AS received, sum(malformed) AS malformed,\n               sum(duplicates) AS \"duplicates dropped\"\n        FROM processor_stats WHERE $__timeFilter(ts)\n        GROUP BY 1 ORDER BY 1"
        }
